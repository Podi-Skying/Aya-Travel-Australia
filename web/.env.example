# Copy to .env.local for local development. Never commit real values.
# Neon connection string (Vercel Marketplace sets this automatically). Leave empty locally to use PGlite in .pglite/.
DATABASE_URL=
# next-auth: random secret (openssl rand -base64 32) and the site URL.
NEXTAUTH_SECRET=
NEXTAUTH_URL=
# GitHub OAuth App credentials.
GITHUB_ID=
GITHUB_SECRET=
# Comma-separated GitHub numeric user ids allowed to sign in as owner (Podi-Skying = 32431832).
OWNER_GITHUB_IDS=
# Random salt for hashing visitor keys (openssl rand -hex 16).
VOTER_HASH_SALT=
